{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Just Write Some Damn Code",
  "version": "0.1.0-alpha.1",
  "identifier": "dev.justwritesomedamncode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Just Write Some Damn Code",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["runner/"],
    "icon": []
  }
}
